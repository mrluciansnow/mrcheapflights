  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "stripe": "^17.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260625.1": true
  }
}
