{
  "name": "mrcheapflights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy .",
    "test": "node tests/sim-parity.mjs && node tests/determinism.mjs",
