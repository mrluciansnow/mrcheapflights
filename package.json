{
  "name": "mrcheapflights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy .",
    "test": "node tests/sim-parity.mjs && node tests/determinism.mjs",
    "test:api": "node tests/mp-api.mjs",
    "db:mp": "wrangler d1 execute mrcheapflights-prod --local --file=migrations/0006_multiplayer.sql",
    "db:mp:remote": "wrangler d1 execute mrcheapflights-prod --remote --file=migrations/0006_multiplayer.sql",
    "test:ui": "node tests/ui-smoke.mjs && node tests/layout.mjs",
    "test:daily": "node tests/daily.mjs",
    "test:balance": "node tests/balance.mjs",
    "test:keeper": "node tests/keeper.mjs",
    "db:duel": "wrangler d1 execute mrcheapflights-prod --local --file=migrations/0006_multiplayer.sql && wrangler d1 execute mrcheapflights-prod --local --file=migrations/0007_duel.sql",
    "db:duel:remote": "wrangler d1 execute mrcheapflights-prod --remote --file=migrations/0007_duel.sql",
    "test:duel": "node tests/duel-api.mjs && node tests/duel-client.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "stripe": "^17.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260625.1": true
  }
}
