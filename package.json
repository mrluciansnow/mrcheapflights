{
  "name": "mrcheapflights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "node scripts/deploy.mjs",
    "deploy:unsafe": "echo 'REFUSED: use npm run deploy (bare wrangler pages deploy . leaks .dev.vars)' && exit 1",
    "smoke": "node scripts/smoke.mjs",
    "migrate": "node tools/migrate.mjs",
    "migrate:remote": "node tools/migrate.mjs --remote",
    "test:parser": "node scripts/test-parser.mjs",
    "test:email": "node scripts/test-email.mjs",
    "test:site": "node scripts/test-parser.mjs && node scripts/test-email.mjs",
    "test:game": "node tests/sim-parity.mjs && node tests/determinism.mjs",
    "test:ui": "node tests/ui-smoke.mjs && node tests/layout.mjs",
    "test:duel": "node tests/duel-api.mjs && node tests/duel-client.mjs && node tests/duel-play.mjs && node tests/duel-lobby.mjs && node tests/duel-queue.mjs",
    "test:daily": "node tests/daily.mjs",
    "test:balance": "node tests/balance.mjs",
    "test:keeper": "node tests/keeper.mjs",
    "test:api": "node tests/mp-api.mjs",
    "test": "npm run test:site && npm run test:game",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "stripe": "^17.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260625.1": true
  }
}
